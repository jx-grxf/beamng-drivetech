"citybus_engine_ecu_drivetech_cursor9": {
    "information":{
        "authors":"jx-grxf",
        "name":"DriveTech Cursor 9 Engine Management",
        "value":900,
    },
    "slotType" : "citybus_engine_ecu",
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$dt_bus_revlimit", "range", "rpm", "DriveTech", 2300, 2100, 2600, "Rev limiter", "Cursor 9 rated speed is 2200 rpm", {"stepDis":50}],
        ["$dt_bus_vmax", "range", "km/h", "DriveTech", 100, 50, 140, "Speed limiter", "EU buses are limited to 100 km/h", {"stepDis":1}],
    ],
    "mainEngine":{
        "revLimiterRPM":"$dt_bus_revlimit",
        "revLimiterType":"soft",
        //Euro VI with particulate filter: hardly any visible smoke
        "particulates":0.02,
    },
    "vehicleController": {
        "topSpeedLimit":"$=$dt_bus_vmax/3.6",
    },
},

"citybus_finaldrive_R_drivetech": {
    "information":{
        "authors":"jx-grxf",
        "name":"DriveTech Rear Final Drive (adjustable)",
        "value":150,
    },
    "slotType" : "citybus_finaldrive_R",
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$dt_bus_finaldrive", "range", ":1", "DriveTech", 4.63, 3.0, 6.5, "Final drive ratio", "Crossway LE with EcoLife: 4.63. Higher = more pull, lower top speed", {"stepDis":0.01}],
    ],
    "differential_R" : {
        "gearRatio":"$dt_bus_finaldrive",
    },
},
}
