{
// DriveTech: Iveco Cursor 9 (8.7 l, Euro VI) calibrations for the Wentward DT40L city bus.
// Urbanway: 265 kW (360 PS) at 2200 rpm, 1650 Nm from 1200 to 1500 rpm.
// Crossway LE 400: 294 kW (400 PS), 1700 Nm from 1200 to 1650 rpm.
// The stock engine block stays; turbo hardware and efficiency curve are tuned so that the
// net torque (after engine friction) follows the Iveco data at full boost.

"citybus_turbo_drivetech_cursor9_360": {
    "information":{
        "authors":"BeamNG, jx-grxf",
        "name":"DriveTech Cursor 9 Turbo (360 PS / 1650 Nm)",
        "value":7200,
    },
    "slotType" : "citybus_turbo",
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$dt_bus_boost_360", "range", "psi", "DriveTech", 39.5, 30, 50, "Boost (wastegate)", "Stock calibration 39.5 psi = 360 PS / 1650 Nm. Higher = more power", {"stepDis":0.5}],
    ],
    "flexbodies": [
        ["mesh", "[group]:"],
    ],
    "turbocharger": {
        "hissLoopEvent":"event:>Vehicle>Forced_Induction>turbo_bus_01>turbo_hiss",
        "whineLoopEvent":"event:>Vehicle>Forced_Induction>turbo_bus_01>turbo_spin",
        "bovEnabled":false,
        "bovSoundVolumeCoef":0.0,
        "hissVolumePerPSI": 0.0,
        "whineVolumePer10kRPM": 0.06,
        "whinePitchPer10kRPM": 0.074,
        "wastegateStart":"$dt_bus_boost_360",
        "wastegateLimit":"$=$dt_bus_boost_360+1",
        "maxExhaustPower": 16000,
        "backPressureCoef": 0.00005,
        "frictionCoef": 12,
        "inertia":15,
        "damageThresholdTemperature": 750,
        "pressurePSI":[
            //turbineRPM, pressure(PSI)
            [0,         0],
            [30000,     10],
            [60000,     20],
            [90000,     36],
            [120000,    46],
            [150000,    52],
            [200000,    58],
            [250000,    63],
            [300000,    66],
        ],
        "engineDef":[
            //engineRPM, efficiency, exhaustFactor
            //full boost from about 1100 rpm, 1650 Nm up to 1500 rpm, then a flat 265 kW to 2200 rpm
            [0,     0,      0],
            [200,   0.37,   0.1],
            [400,   0.51,   0.3],
            [600,   0.64,   0.54],
            [800,   0.76,   0.75],
            [1000,  0.677,  0.87],
            [1200,  0.78,   0.9],
            [1400,  0.805,  0.87],
            [1500,  0.831,  0.81],
            [1600,  0.807,  0.75],
            [1800,  0.725,  0.67],
            [2000,  0.672,  0.59],
            [2200,  0.74,   0.51],
            [2400,  0.288,  0.43],
            [2600,  0.03,   0.35],
            [2800,  0,      0.26],
            [3000,  0,      0.18],
        ],
    },
    "mainEngine": {
        "turbocharger":"turbocharger",
        "deformGroups_turbo":["mainEngine_turbo","mainEngine_intercooler","mainEngine_piping"]
    },
},

