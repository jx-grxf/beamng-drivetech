{
// DriveTech: ZF 8HP50 8-speed automatic for the ETK family (BMW 320i/330i/340i, 320d).
// Same part as the stock ETK 8-speed automatic (which has the 8HP70 ratios of the 330d / 335d),
// only the gear ratios differ. Source: BMW Group technical data F31 LCI (11/2018).

"etk_transmission_8A_drivetech_8hp50": {
    "information":{
        "authors":"BeamNG, jx-grxf",
        "name":"DriveTech 8-Speed Automatic (ZF 8HP50)",
        "value":2800,
