"etk_finaldrive_R_drivetech": {
    "information":{
        "authors":"jx-grxf",
        "name":"DriveTech Rear Final Drive (adjustable)",
        "value":150,
    },
    "slotType" : "etk_finaldrive_R",
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$dt_finaldrive", "range", ":1", "DriveTech", 2.563, 2.2, 4.1, "Final drive ratio", "330d xDrive: 2.563, 320d: approx. 2.81. Front and rear share this value", {"stepDis":0.001}],
    ],
    "differential_R" : {
        "gearRatio":"$dt_finaldrive",
    },
},

