{
// DriveTech: BMW-like engine calibrations and final drives for the ETK family.
// All values are adjustable in the Tuning menu (category "DriveTech").

"etk_engine_i6_3.0_diesel_ecu_drivetech_330d": {
    "information":{
        "authors":"jx-grxf",
        "name":"DriveTech 330d ECU (approx. 258 PS / 560 Nm)",
        "value":1500,
    },
    "slotType" : "etk_engine_i6_3.0_diesel_ecu",
    "slots": [
        ["type", "default", "description"],
        ["etk_engine_ecu_speedlimit","etk_engine_ecu_speedlimit_250", "Speed Limiter", {"coreSlot":true}],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$dt_330d_boost", "range", "psi", "DriveTech", 15, 10, 30, "Boost (wastegate)", "Stock approx. 15 psi. Higher = more power", {"stepDis":0.5}],
        ["$dt_330d_revlimit", "range", "rpm", "DriveTech", 5000, 4400, 5800, "Rev limiter", "Stock 330d: approx. 5000 rpm", {"stepDis":50}],
    ],
    "mainEngine":{
        "revLimiterRPM":"$dt_330d_revlimit",
        "revLimiterType": "soft",
    },
    "turbocharger": {
        "wastegateStart":"$dt_330d_boost",
        "maxExhaustPower": 4000,
        "engineDef":[
            //engineRPM, efficiency, exhaustFactor (same as the ETK 260 ECU)
            [0,     0.0,    0.5],
            [650,   0.3,   0.55],
            [850,   0.5,   0.55],
            [1000,   0.6,   0.75],
            [1450,  0.90,    0.8],
            [2000,  0.84,    0.8],
            [2500,  0.81,    1.0],
            [3000,  0.80,    1.0],
            [4000,  0.68,    1.0],
            [4500,  0.62,    1.0],
            [5000,  0.60,    1.0],
            [6000,  0.45,    1.0],
            [8000,  0.05,    0.01],
        ],
    }
},

